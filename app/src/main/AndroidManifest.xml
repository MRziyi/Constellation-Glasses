<?xml version="1.0" encoding="utf-8"?>
<!--
  Main manifest — shared across the `glass` and `phoneDebug` product flavors.
  Per-flavor add-ons live in:
    src/glass/AndroidManifest.xml        (HUD Activity, FGS microphone)
    src/phoneDebug/AndroidManifest.xml   (SYSTEM_ALERT_WINDOW for overlay)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Halo Ring (optional companion). We detect at boot; if absent, all
         interactions still work through the on-eyepiece touch+button. -->
    <queries>
        <package android:name="com.halo.ring" />
    </queries>

    <!-- ── Permissions ─────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ForegroundService — survives Doze + background-execution limits.
         FGS_MICROPHONE / FGS_CAMERA are declared in the per-flavor manifests
         because both flavors need them but the targetApi=34 attribute warns
         there.
         FGS_DATA_SYNC (added 2026-05-29, P1.8 finding): the persistent WSS
         keepalive doesn't qualify as `microphone` or `camera` type when
         we're idle (eager-close per C-42 means mic isn't actively recording).
         Real-device dumpsys confirmed Android demoted us to PERCEPTIBLE_APP_ADJ
         (200, killable) instead of FOREGROUND_SERVICE_ADJ (100). The
         `dataSync` type matches the WSS keepalive semantic and keeps us
         foregrounded across idle periods. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:targetApi="34" />

    <!-- Mic — for AudioCapture (glass: 0x6000FC channel mask;
         phoneDebug: standard mono). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Halo Ring plugin trigger (no-op if Halo Ring isn't installed). -->
    <uses-permission android:name="com.halo.ring.permission.TRIGGER"
        tools:ignore="ProtectedPermissions" />

    <!-- Camera — shortcut photo=true capture + QR-code login scanner. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".ConstellationApp"
        android:label="Constellation"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Constellation"
        tools:targetApi="32">

        <!-- ── Launcher Activity: one-shot password login + service start ── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Foreground service ── -->
        <!-- `microphone` for the AudioCapture / listening pipeline; `camera`
             for the shortcut photo capture (P-app.Q.3) — Android 14+ blocks
             background camera access without an FGS type declaring it.
             On Rokid Glasses (YodaOS-Sprite), the FGS type alone is NOT
             enough — AppOps `CAMERA: foreground` strictly requires a
             RESUMED Activity. See CameraGateActivity below. -->
        <service
            android:name=".ConstellationService"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone|camera"
            tools:targetApi="34" />

        <!-- ── CameraGateActivity — one-shot transparent gate for camera capture ── -->
        <!-- Used on Rokid Glasses where AppOps `CAMERA: foreground` blocks
             Service-initiated camera open even with FGS_CAMERA type declared.
             Launches transparently for ~2s while CameraCapture runs, then
             finishes. Wearer sees a brief panel blink. -->
        <activity
            android:name=".camera.CameraGateActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            tools:targetApi="32" />

        <!-- ── BootReceiver ── -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ── Halo Ring plugin (optional companion) ── -->
        <meta-data
            android:name="halo.ring.plugin_version"
            android:value="1" />
        <receiver
            android:name=".halo.HaloTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.halo.ring.action.TRIGGER" />
            </intent-filter>
        </receiver>
        <provider
            android:name=".halo.HaloActionsProvider"
            android:authorities="com.constellation.glass.halo_actions"
            android:exported="true"
            android:grantUriPermissions="false" />

    </application>
</manifest>
